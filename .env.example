# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/china_league?schema=public"

# Optional: enable scheduled crawl
ENABLE_SCHEDULED_CRAWL="false"

# User-Agent used by scrapers (be polite, identify yourself)
SCRAPER_USER_AGENT="ChinaLeagueTrackerBot/0.1 (+contact: youremail@example.com)"

# Request frequency limits (ms)
SCRAPER_MIN_INTERVAL_MS="2000"
